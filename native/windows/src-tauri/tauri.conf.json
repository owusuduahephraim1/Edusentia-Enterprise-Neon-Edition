{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Edusentia Enterprise Neon Edition",
  "version": "7.4.1",
  "identifier": "app.edusentia.enterprise.neon",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [
      {
        "title": "Edusentia Enterprise Neon Edition",
        "url": "https://owusuduahephraim1.github.io/Edusentia-Enterprise-Neon-Edition/",
        "width": 1200,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "edusentia-remote-document-save",
          "description": "Permit only the Edusentia GitHub Pages application to invoke the user-approved Save As command",
          "windows": [
            "main"
          ],
          "remote": {
            "urls": [
              "https://owusuduahephraim1.github.io/Edusentia-Enterprise-Neon-Edition/*"
            ]
          },
          "local": false,
          "platforms": [
            "windows"
          ],
          "permissions": [
            "allow-save-document"
          ]
        }
      ]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "publisher": "Ephraim Owusu-Duah",
    "shortDescription": "Edusentia Enterprise Neon school operations",
    "longDescription": "Edusentia Enterprise Neon Edition school administration and academic operations platform.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
